# Local development image. CI uses ruby/setup-ruby instead.
# ponytail: Ruby version duplicated from .ruby-version; bump both together.
FROM ruby:3.4.12

# ImageMagick for the thumbnails generated by post-build.sh; npm for USWDS.
RUN apt-get update && apt-get install -y --no-install-recommends imagemagick nodejs npm && rm -rf /var/lib/apt/lists/*
ENV BUNDLE_BUILD__SASSC=--disable-march-tune-native

WORKDIR /site
COPY Gemfile Gemfile.lock package.json package-lock.json ./
RUN bundle install && npm ci

EXPOSE 4000
CMD ["bundle", "exec", "jekyll", "serve", "--host", "0.0.0.0"]
